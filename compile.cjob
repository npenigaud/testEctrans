#!/bin/bash

testFolderName=ectransGPUdouble
if [ ! -z "$1" ]; then
  testFolderName=$1
fi
echo "Testing in ${testFolderName}"
export ARCH="${PWD}/arch/ecmwf/hpc2020/nvhpc/gpu-cuda/"
echo "Arch : $ARCH" 
#== copy test folder to TMPDIR and go into it

echo "copying ${PWD}/${testFolderName} to $TMPDIR"
cp -r ${PWD}/${testFolderName} $TMPDIR
cd $TMPDIR/${testFolderName}


# bull specific environment variables
set -x
ulimit -s unlimited


#== load compilation environment

source $ARCH/env.sh

#== Compilation

# fckit
cmake -S fckit -B fckit/build 
cmake --build fckit/build -j 8 

# fiat
cmake -S fiat -B fiat/build -DCMAKE_Fortran_FLAGS="-fPIC" -DCMAKE_POSITION_INDEPENDENT_CODE=ON -Dfckit_ROOT=$PWD/fckit/build -DENABLE_GPU=ON -DENABLE_ACC=ON
cmake --build fiat/build -j 8 

# ectrans
cmake -S ectrans -B ectrans/build -Dfiat_ROOT=$PWD/fiat/build -DECTRANS_ENABLE_GPU=ON -DENABLE_ACC=ON 
cmake --build ectrans/build -j 8


